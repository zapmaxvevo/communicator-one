POSTGRES_DB=communicator_one
POSTGRES_PORT=5432
REDIS_PORT=6379

DB_HOST=localhost
DB_USERNAME=communicator_one
DB_PASSWORD=communicator_one

# Al menos 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=

# Horario del job de cierre de oportunidades (cron de Spring, default en application.yml).
# "-" lo desactiva, por ejemplo en réplicas que no tienen que correrlo.
# COMMUNICATOR_ONE_OPPORTUNITIES_CLOSING_CRON=0 0 * * * *

# Espera máxima del job de cierre por una oportunidad bloqueada; al vencer saltea esa organización
# hasta la próxima corrida (default en application.yml). Con unidad (10s, 500ms); sin unidad son
# milisegundos. 0 = sin límite.
# COMMUNICATOR_ONE_OPPORTUNITIES_CLOSING_LOCK_TIMEOUT=10s
